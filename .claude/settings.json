{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(poetry run pytest *)",
      "Bash(poetry add *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(.env)",
      "Bash(sudo *)",
      "Bash(rm *)",
      "Bash(git push * main)"
    ]
  }
}
