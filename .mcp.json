{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "node",
      "args": [
        "mcp/mcp-spy.mjs",
        "npx",
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "node",
      "args": [
        "mcp/mcp-spy.mjs",
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "env": {}
    },
    "oncall": {
      "type": "http",
      "url": "http://127.0.0.1:8900/mcp"
    }
  }
}
